{
    "train_batch_size": "auto",
    "gradient_accumulation_steps": "auto",
  
    "optimizer": {
      "type": "AdamW",
      "params": {
        "lr": "auto",
        "betas": [0.9, 0.999],
        "eps": 1e-8,
        "weight_decay": "auto"
      }
    },
  
    "bf16": { "enabled": true },
  
    "zero_optimization": {
      "stage": 3,
      "offload_param": {
        "device": "cpu",
        "pin_memory": true
      },
      "offload_optimizer": {
        "device": "cpu",
        "pin_memory": true
      },
      "allgather_partitions": true,
      "reduce_scatter": true,
      "overlap_comm": true,
      "contiguous_gradients": true,
      "allgather_bucket_size": 5e8
    }
  }
  